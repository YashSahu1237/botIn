<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://yesmadam.in/botin">

  <!--
    TRIGGER A. The partner rated a resolution "No", and a human takes it from here.

    WHY THIS IS A SECOND PROCESS RATHER THAN A WAIT INSIDE THE FIRST ONE. Trigger A is
    the only one of the five that fires AFTER the instance has completed. Holding every
    resolved session open on a Receive Task just in case would charge runtime state to
    every T0, T1 and T2 to serve the minority who are unhappy, and would make "a
    completed instance has no runtime rows" — the property ADR-001 and the whole
    nextStep design rest on — conditional. See CsatService for the full decision (O-15).

    IT HAS NO DECISION STEP, ON PURPOSE. Nothing here fetches facts or consults a table,
    because nothing is in doubt: the partner has just told us the answer was wrong. Tier,
    action and trigger are all set before the process starts, and this flow only carries
    them to a person.

    Gate 1 is still crossed in exactly one place. openTicketDelegate REUSES the ticket
    this conversation already has, or opens one where the resolution was a T0 and there
    was none — which is the case worth naming: a deflection that failed is no longer a
    deflection, and it becomes a real ticket at the moment the partner says so.
  -->

  <process id="csat-escalation" name="CSAT dissatisfaction — agent connect" isExecutable="true">

    <startEvent id="start"/>
    <sequenceFlow id="c-start" sourceRef="start" targetRef="openTicket"/>

    <serviceTask id="openTicket" name="Gate 1 — reuse or open the ticket"
                 flowable:delegateExpression="${openTicketDelegate}"/>
    <sequenceFlow id="c-gate1" sourceRef="openTicket" targetRef="escalationContext"/>

    <serviceTask id="escalationContext" name="Write escalation context"
                 flowable:delegateExpression="${escalationContextDelegate}"/>
    <sequenceFlow id="c-context" sourceRef="escalationContext" targetRef="agentHandoff"/>

    <serviceTask id="agentHandoff" name="Tell the partner"
                 flowable:delegateExpression="${agentHandoffDelegate}"/>
    <sequenceFlow id="c-handoff" sourceRef="agentHandoff" targetRef="agentConnect"/>

    <!-- The SAME task key as the generic process, so one queue holds both and an agent
         never has to know which route a case arrived by. -->
    <userTask id="agentConnect" name="Agent connect"
              flowable:candidateGroups="${agentQueue}"/>
    <sequenceFlow id="c-claimed" sourceRef="agentConnect" targetRef="agentCompletion"/>

    <serviceTask id="agentCompletion" name="Close out the agent's resolution"
                 flowable:delegateExpression="${agentCompletionDelegate}"/>
    <sequenceFlow id="c-end" sourceRef="agentCompletion" targetRef="end"/>

    <endEvent id="end"/>

  </process>
</definitions>
