<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="defs-viol-r5-periods-decision"
             name="viol-r5-periods-decision"
             namespace="http://yesmadam.in/botin">

  <!-- VIOL_R5_PERIODS — 2 rules. One period leave per calendar month.

       priorPeriodLeavesThisMonth counts leaves taken BEFORE this request, and it comes
       from sp_counter — state this engine owns, not a fact it can read from anywhere
       else. The limit of 1 is in the table, so changing it is a file redeploy.

       UPHOLD is a real outcome, not a failure. The violation stands and the partner is
       told why.
  -->

  <decision id="viol-r5-periods-decision" name="viol-r5-periods-decision">
    <decisionTable id="dt-viol-r5-periods-decision" hitPolicy="FIRST">

      <input id="i1" label="priorPeriodLeavesThisMonth">
        <inputExpression id="ie1" typeRef="number"><text>priorPeriodLeavesThisMonth</text></inputExpression>
      </input>

      <output id="o1" label="tier" name="tier" typeRef="string"/>
      <output id="o2" label="action" name="action" typeRef="string"/>
      <output id="o3" label="outcomeType" name="outcomeType" typeRef="string"/>

      <!-- 1. First one this month. Remove the violation. -->
      <rule id="r1">
        <inputEntry id="r1i1"><text>&lt; 1</text></inputEntry>
        <outputEntry id="r1o1"><text>&quot;T2&quot;</text></outputEntry>
        <outputEntry id="r1o2"><text>&quot;REMOVE_VIOLATION&quot;</text></outputEntry>
        <outputEntry id="r1o3"><text>&quot;BOT&quot;</text></outputEntry>
      </rule>

      <!-- 2. Second or later. The limit is one per month. -->
      <rule id="r2">
        <inputEntry id="r2i1"><text>&gt;= 1</text></inputEntry>
        <outputEntry id="r2o1"><text>&quot;T1&quot;</text></outputEntry>
        <outputEntry id="r2o2"><text>&quot;UPHOLD_MONTHLY_LIMIT&quot;</text></outputEntry>
        <outputEntry id="r2o3"><text>&quot;UPHOLD&quot;</text></outputEntry>
      </rule>

      <!-- 3. CATCH-ALL. Must stay last. Without it, an unmatched case returns null and the gateway reading tier has nowhere to go. -->
      <rule id="r3">
        <inputEntry id="r3i1"><text></text></inputEntry>
        <outputEntry id="r3o1"><text>&quot;T3&quot;</text></outputEntry>
        <outputEntry id="r3o2"><text>&quot;AGENT_UNMATCHED&quot;</text></outputEntry>
        <outputEntry id="r3o3"><text>&quot;TICKET&quot;</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
