<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="defs-viol-r9-no-product-decision"
             name="viol-r9-no-product-decision"
             namespace="http://yesmadam.in/botin">

  <!-- VIOL_R9_NO_PRODUCT — 4 rules. The partner had no product, and says that is why.

       pastDeliveryTat MUST come from the shared Express/Standard TAT service with the
       11 PM deadline — the same one PROD_DELIVERY_DELAY uses. NOT a flat three days.
       Two concerns sharing one definition is the point; a checkpoint later changes the
       TAT rule once and asserts both concerns move together.

       priorRemovalsThisCycle comes from sp_counter. One allowance per 25-job cycle, and
       the 1 is in the table.
  -->

  <decision id="viol-r9-no-product-decision" name="viol-r9-no-product-decision">
    <decisionTable id="dt-viol-r9-no-product-decision" hitPolicy="FIRST">

      <input id="i1" label="orderPlaced">
        <inputExpression id="ie1" typeRef="boolean"><text>orderPlaced</text></inputExpression>
      </input>
      <input id="i2" label="pastDeliveryTat">
        <inputExpression id="ie2" typeRef="boolean"><text>pastDeliveryTat</text></inputExpression>
      </input>
      <input id="i3" label="priorRemovalsThisCycle">
        <inputExpression id="ie3" typeRef="number"><text>priorRemovalsThisCycle</text></inputExpression>
      </input>

      <output id="o1" label="tier" name="tier" typeRef="string"/>
      <output id="o2" label="action" name="action" typeRef="string"/>
      <output id="o3" label="outcomeType" name="outcomeType" typeRef="string"/>

      <!-- 1. Never ordered one. The violation stands, with a reminder. -->
      <rule id="r1">
        <inputEntry id="r1i1"><text>false</text></inputEntry>
        <inputEntry id="r1i2"><text></text></inputEntry>
        <inputEntry id="r1i3"><text></text></inputEntry>
        <outputEntry id="r1o1"><text>&quot;T1&quot;</text></outputEntry>
        <outputEntry id="r1o2"><text>&quot;UPHOLD_REMIND_ORDER&quot;</text></outputEntry>
        <outputEntry id="r1o3"><text>&quot;UPHOLD&quot;</text></outputEntry>
      </rule>

      <!-- 2. Ordered, but logistics missed the TAT. That is our failure, not the partner's. -->
      <rule id="r2">
        <inputEntry id="r2i1"><text>true</text></inputEntry>
        <inputEntry id="r2i2"><text>true</text></inputEntry>
        <inputEntry id="r2i3"><text></text></inputEntry>
        <outputEntry id="r2o1"><text>&quot;T3&quot;</text></outputEntry>
        <outputEntry id="r2o2"><text>&quot;TICKET_LOGISTICS_FAILURE&quot;</text></outputEntry>
        <outputEntry id="r2o3"><text>&quot;TICKET&quot;</text></outputEntry>
      </rule>

      <!-- 3. Ordered, within TAT, allowance still available. Remove it. -->
      <rule id="r3">
        <inputEntry id="r3i1"><text>true</text></inputEntry>
        <inputEntry id="r3i2"><text>false</text></inputEntry>
        <inputEntry id="r3i3"><text>&lt; 1</text></inputEntry>
        <outputEntry id="r3o1"><text>&quot;T2&quot;</text></outputEntry>
        <outputEntry id="r3o2"><text>&quot;REMOVE_VIOLATION&quot;</text></outputEntry>
        <outputEntry id="r3o3"><text>&quot;BOT&quot;</text></outputEntry>
      </rule>

      <!-- 4. Ordered, within TAT, but the cycle allowance is already spent. -->
      <rule id="r4">
        <inputEntry id="r4i1"><text>true</text></inputEntry>
        <inputEntry id="r4i2"><text>false</text></inputEntry>
        <inputEntry id="r4i3"><text>&gt;= 1</text></inputEntry>
        <outputEntry id="r4o1"><text>&quot;T1&quot;</text></outputEntry>
        <outputEntry id="r4o2"><text>&quot;UPHOLD_ALLOWANCE_USED&quot;</text></outputEntry>
        <outputEntry id="r4o3"><text>&quot;UPHOLD&quot;</text></outputEntry>
      </rule>

      <!-- 5. CATCH-ALL. Must stay last. Without it, an unmatched case returns null and the gateway reading tier has nowhere to go. -->
      <rule id="r5">
        <inputEntry id="r5i1"><text></text></inputEntry>
        <inputEntry id="r5i2"><text></text></inputEntry>
        <inputEntry id="r5i3"><text></text></inputEntry>
        <outputEntry id="r5o1"><text>&quot;T3&quot;</text></outputEntry>
        <outputEntry id="r5o2"><text>&quot;AGENT_UNMATCHED&quot;</text></outputEntry>
        <outputEntry id="r5o3"><text>&quot;TICKET&quot;</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
