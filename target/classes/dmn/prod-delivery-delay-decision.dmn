<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="defs-prod-delivery-delay-decision"
             name="prod-delivery-delay-decision"
             namespace="http://yesmadam.in/botin">

  <!-- PROD_DELIVERY_DELAY — 2 rules. 2,306/month, second highest in the build.

       pastElevenPmDeadline comes from the SHARED TAT service. VIOL_R9 reads the same
       function. If this concern and that one ever disagree about what "late" means, one
       of them is wrong and a partner is being told two different things.
  -->

  <decision id="prod-delivery-delay-decision" name="prod-delivery-delay-decision">
    <decisionTable id="dt-prod-delivery-delay-decision" hitPolicy="FIRST">

      <input id="i1" label="pastElevenPmDeadline">
        <inputExpression id="ie1" typeRef="boolean"><text>pastElevenPmDeadline</text></inputExpression>
      </input>

      <output id="o1" label="tier" name="tier" typeRef="string"/>
      <output id="o2" label="action" name="action" typeRef="string"/>
      <output id="o3" label="outcomeType" name="outcomeType" typeRef="string"/>

      <!-- 1. Past the 11 PM deadline for its TAT. Logistics escalation. -->
      <rule id="r1">
        <inputEntry id="r1i1"><text>true</text></inputEntry>
        <outputEntry id="r1o1"><text>&quot;T3&quot;</text></outputEntry>
        <outputEntry id="r1o2"><text>&quot;TICKET_LOGISTICS_ESCALATION&quot;</text></outputEntry>
        <outputEntry id="r1o3"><text>&quot;TICKET&quot;</text></outputEntry>
      </rule>

      <!-- 2. Still inside TAT. Show the expected date and ask them to wait. -->
      <rule id="r2">
        <inputEntry id="r2i1"><text>false</text></inputEntry>
        <outputEntry id="r2o1"><text>&quot;T1&quot;</text></outputEntry>
        <outputEntry id="r2o2"><text>&quot;SHOW_EXPECTED_DELIVERY&quot;</text></outputEntry>
        <outputEntry id="r2o3"><text>&quot;BOT&quot;</text></outputEntry>
      </rule>

      <!-- 3. CATCH-ALL. Must stay last. Without it, an unmatched case returns null and the gateway reading tier has nowhere to go. -->
      <rule id="r3">
        <inputEntry id="r3i1"><text></text></inputEntry>
        <outputEntry id="r3o1"><text>&quot;T3&quot;</text></outputEntry>
        <outputEntry id="r3o2"><text>&quot;AGENT_UNMATCHED&quot;</text></outputEntry>
        <outputEntry id="r3o3"><text>&quot;TICKET&quot;</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
