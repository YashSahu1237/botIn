<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="defs-transport-not-received"
             name="transport-not-received-decision"
             namespace="http://yesmadam.in/botin">

  <!-- TRANSPORT_NOT_RECEIVED — 9 rules from the concern mapping. Highest volume
       concern in the build (5,615/month) and the only one here that pays out on
       three different bases.

       HIT POLICY IS FIRST. Row order is logic, not formatting.

       ROW ORDER CHANGED FROM THE MAPPING, DELIBERATELY. The mapping lists the
       Rs300 cap LAST, as rule 9. Under FIRST that is wrong and silently so: a
       Path 3 claim computing Rs450 matches the credit row above it, fires, and
       pays Rs450 — the cap row is never reached. The cap is therefore row 2 here,
       above every row that can pay. Nothing else about it changed.

       transportPath is a DERIVED fact, not one the mapping defines. See
       TransportPathSelector — it is an assumption pending the real
       path-selector rule. -->

  <decision id="transport-not-received-decision" name="transport-not-received-decision">
    <decisionTable id="dt-transport" hitPolicy="FIRST">

      <input id="i-credited" label="alreadyCredited">
        <inputExpression id="ie-credited" typeRef="boolean"><text>alreadyCredited</text></inputExpression>
      </input>
      <input id="i-amount" label="computedAmountRupees">
        <inputExpression id="ie-amount" typeRef="number"><text>computedAmountRupees</text></inputExpression>
      </input>
      <input id="i-path" label="transportPath">
        <inputExpression id="ie-path" typeRef="string"><text>transportPath</text></inputExpression>
      </input>
      <input id="i-arrived" label="arrivedAt300metre">
        <inputExpression id="ie-arrived" typeRef="boolean"><text>arrivedAt300metre</text></inputExpression>
      </input>
      <input id="i-cancel" label="cancellationStatus">
        <inputExpression id="ie-cancel" typeRef="string"><text>cancellationStatus</text></inputExpression>
      </input>
      <input id="i-cashback" label="lastMinCashbackCredited">
        <inputExpression id="ie-cashback" typeRef="boolean"><text>lastMinCashbackCredited</text></inputExpression>
      </input>
      <input id="i-beyond" label="distanceBeyondRadiusKm">
        <inputExpression id="ie-beyond" typeRef="number"><text>distanceBeyondRadiusKm</text></inputExpression>
      </input>

      <output id="o-tier"    label="tier"        name="tier"        typeRef="string"/>
      <output id="o-action"  label="action"      name="action"      typeRef="string"/>
      <output id="o-type"    label="outcomeType" name="outcomeType" typeRef="string"/>
      <output id="o-rate"    label="ratePerKmRupees" name="ratePerKmRupees" typeRef="number"/>

      <!-- 1. Already paid for this order. Beats everything. -->
      <rule id="t1">
        <inputEntry id="t1i1"><text>true</text></inputEntry>
        <inputEntry id="t1i2"><text></text></inputEntry>
        <inputEntry id="t1i3"><text></text></inputEntry>
        <inputEntry id="t1i4"><text></text></inputEntry>
        <inputEntry id="t1i5"><text></text></inputEntry>
        <inputEntry id="t1i6"><text></text></inputEntry>
        <inputEntry id="t1i7"><text></text></inputEntry>
        <outputEntry id="t1o1"><text>"T1"</text></outputEntry>
        <outputEntry id="t1o2"><text>"INFORM_ALREADY_PAID"</text></outputEntry>
        <outputEntry id="t1o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t1o4"><text>0</text></outputEntry>
      </rule>

      <!-- 2. THE CAP. Rs300. Mapping rule 9.

           AMOUNTS HERE ARE RUPEES, not paise. The threshold read > 30000 until money moved
           to rupees; a business owner editing this row now writes what they would say out
           loud. If you ever see a four- or five-figure threshold here again, it is a unit
           that was not converted.

           MUST STAY ABOVE EVERY PAYING ROW. Under FIRST the catch-all at the
           bottom matches everything, so a cap placed below it can never fire and
           a Rs450 claim falls through to PATH 1 and is paid in full. Only rule 1
           (already paid) belongs above this one. -->
      <rule id="t2">
        <inputEntry id="t2i1"><text></text></inputEntry>
        <inputEntry id="t2i2"><text>&gt; 300</text></inputEntry>
        <inputEntry id="t2i3"><text></text></inputEntry>
        <inputEntry id="t2i4"><text></text></inputEntry>
        <inputEntry id="t2i5"><text></text></inputEntry>
        <inputEntry id="t2i6"><text></text></inputEntry>
        <inputEntry id="t2i7"><text></text></inputEntry>
        <outputEntry id="t2o1"><text>"T3"</text></outputEntry>
        <outputEntry id="t2o2"><text>"TICKET_EXCEEDS_CAP"</text></outputEntry>
        <outputEntry id="t2o3"><text>"TICKET"</text></outputEntry>
        <outputEntry id="t2o4"><text>0</text></outputEntry>
      </rule>

      <!-- 3. PATH 1 — customer paid transport, it never reached the SP wallet. -->
      <rule id="t3">
        <inputEntry id="t3i1"><text></text></inputEntry>
        <inputEntry id="t3i2"><text></text></inputEntry>
        <inputEntry id="t3i3"><text>"PATH_1"</text></inputEntry>
        <inputEntry id="t3i4"><text></text></inputEntry>
        <inputEntry id="t3i5"><text></text></inputEntry>
        <inputEntry id="t3i6"><text></text></inputEntry>
        <inputEntry id="t3i7"><text></text></inputEntry>
        <outputEntry id="t3o1"><text>"T2"</text></outputEntry>
        <outputEntry id="t3o2"><text>"AUTO_CREDIT_TRANSPORT"</text></outputEntry>
        <outputEntry id="t3o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t3o4"><text>0</text></outputEntry>
      </rule>

      <!-- 4. PATH 2 — the SP never got there. -->
      <rule id="t4">
        <inputEntry id="t4i1"><text></text></inputEntry>
        <inputEntry id="t4i2"><text></text></inputEntry>
        <inputEntry id="t4i3"><text>"PATH_2"</text></inputEntry>
        <inputEntry id="t4i4"><text>false</text></inputEntry>
        <inputEntry id="t4i5"><text></text></inputEntry>
        <inputEntry id="t4i6"><text></text></inputEntry>
        <inputEntry id="t4i7"><text></text></inputEntry>
        <outputEntry id="t4o1"><text>"T1"</text></outputEntry>
        <outputEntry id="t4o2"><text>"DENY_DID_NOT_TRAVEL"</text></outputEntry>
        <outputEntry id="t4o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t4o4"><text>0</text></outputEntry>
      </rule>

      <!-- 5a / 5b. PATH 2 — arrived, and the cancellation was not the customer's doing.
           ONE ROW PER STATUS, NOT A COMMA-SEPARATED LIST. The list form
           ("CANCELLED_NR","CANCELLED_BY_AGENT") is written up as valid but did not
           evaluate here: with a non-null cancellationStatus the expression failed, and
           a failed expression takes the WHOLE decision down — every row, including the
           catch-all, so the table returned nothing at all. One value per row costs two
           lines and cannot fail that way. -->
      <rule id="t5a">
        <inputEntry id="t5ai1"><text></text></inputEntry>
        <inputEntry id="t5ai2"><text></text></inputEntry>
        <inputEntry id="t5ai3"><text>"PATH_2"</text></inputEntry>
        <inputEntry id="t5ai4"><text>true</text></inputEntry>
        <inputEntry id="t5ai5"><text>"CANCELLED_NR"</text></inputEntry>
        <inputEntry id="t5ai6"><text></text></inputEntry>
        <inputEntry id="t5ai7"><text></text></inputEntry>
        <outputEntry id="t5ao1"><text>"T2"</text></outputEntry>
        <outputEntry id="t5ao2"><text>"AUTO_CREDIT_TRANSPORT"</text></outputEntry>
        <outputEntry id="t5ao3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t5ao4"><text>0</text></outputEntry>
      </rule>

      <rule id="t5b">
        <inputEntry id="t5bi1"><text></text></inputEntry>
        <inputEntry id="t5bi2"><text></text></inputEntry>
        <inputEntry id="t5bi3"><text>"PATH_2"</text></inputEntry>
        <inputEntry id="t5bi4"><text>true</text></inputEntry>
        <inputEntry id="t5bi5"><text>"CANCELLED_BY_AGENT"</text></inputEntry>
        <inputEntry id="t5bi6"><text></text></inputEntry>
        <inputEntry id="t5bi7"><text></text></inputEntry>
        <outputEntry id="t5bo1"><text>"T2"</text></outputEntry>
        <outputEntry id="t5bo2"><text>"AUTO_CREDIT_TRANSPORT"</text></outputEntry>
        <outputEntry id="t5bo3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t5bo4"><text>0</text></outputEntry>
      </rule>

      <!-- 6. PATH 2 — customer cancelled and the last-minute cashback already paid
           for the journey. Paying transport too would pay twice. -->
      <rule id="t6">
        <inputEntry id="t6i1"><text></text></inputEntry>
        <inputEntry id="t6i2"><text></text></inputEntry>
        <inputEntry id="t6i3"><text>"PATH_2"</text></inputEntry>
        <inputEntry id="t6i4"><text>true</text></inputEntry>
        <inputEntry id="t6i5"><text>"CANCELLED_CR"</text></inputEntry>
        <inputEntry id="t6i6"><text>true</text></inputEntry>
        <inputEntry id="t6i7"><text></text></inputEntry>
        <outputEntry id="t6o1"><text>"T1"</text></outputEntry>
        <outputEntry id="t6o2"><text>"DENY_CASHBACK_COMPENSATES"</text></outputEntry>
        <outputEntry id="t6o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t6o4"><text>0</text></outputEntry>
      </rule>

      <!-- 7. PATH 2 — customer cancelled but no cashback landed. That should not
           happen, which is exactly why it goes to a human rather than a guess. -->
      <rule id="t7">
        <inputEntry id="t7i1"><text></text></inputEntry>
        <inputEntry id="t7i2"><text></text></inputEntry>
        <inputEntry id="t7i3"><text>"PATH_2"</text></inputEntry>
        <inputEntry id="t7i4"><text>true</text></inputEntry>
        <inputEntry id="t7i5"><text>"CANCELLED_CR"</text></inputEntry>
        <inputEntry id="t7i6"><text>false</text></inputEntry>
        <inputEntry id="t7i7"><text></text></inputEntry>
        <outputEntry id="t7o1"><text>"T3"</text></outputEntry>
        <outputEntry id="t7o2"><text>"TICKET_CASHBACK_ANOMALY"</text></outputEntry>
        <outputEntry id="t7o3"><text>"TICKET"</text></outputEntry>
        <outputEntry id="t7o4"><text>0</text></outputEntry>
      </rule>

      <!-- 8. PATH 3 — the job sits inside the hub radius. Distance is measured from
           the radius EDGE, so "within" is <= 0 km beyond it. -->
      <rule id="t8">
        <inputEntry id="t8i1"><text></text></inputEntry>
        <inputEntry id="t8i2"><text></text></inputEntry>
        <inputEntry id="t8i3"><text>"PATH_3"</text></inputEntry>
        <inputEntry id="t8i4"><text></text></inputEntry>
        <inputEntry id="t8i5"><text></text></inputEntry>
        <inputEntry id="t8i6"><text></text></inputEntry>
        <inputEntry id="t8i7"><text>&lt;= 0</text></inputEntry>
        <outputEntry id="t8o1"><text>"T1"</text></outputEntry>
        <outputEntry id="t8o2"><text>"DENY_WITHIN_HUB"</text></outputEntry>
        <outputEntry id="t8o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t8o4"><text>0</text></outputEntry>
      </rule>

      <!-- 9. PATH 3 — beyond the radius. Rs50/km, and the rate lives
           HERE rather than in Java, so changing it is a redeploy of one file. -->
      <rule id="t9">
        <inputEntry id="t9i1"><text></text></inputEntry>
        <inputEntry id="t9i2"><text></text></inputEntry>
        <inputEntry id="t9i3"><text>"PATH_3"</text></inputEntry>
        <inputEntry id="t9i4"><text></text></inputEntry>
        <inputEntry id="t9i5"><text></text></inputEntry>
        <inputEntry id="t9i6"><text></text></inputEntry>
        <inputEntry id="t9i7"><text>&gt; 0</text></inputEntry>
        <outputEntry id="t9o1"><text>"T2"</text></outputEntry>
        <outputEntry id="t9o2"><text>"AUTO_CREDIT_DISTANCE"</text></outputEntry>
        <outputEntry id="t9o3"><text>"BOT"</text></outputEntry>
        <outputEntry id="t9o4"><text>50</text></outputEntry>
      </rule>

      <!-- 10. CATCH-ALL. Must stay last. Without it a case matching nothing returns
           null and the gateway reading tier has nowhere to go — spike 2 proved that
           is silent, not an error. -->
      <rule id="t10">
        <inputEntry id="t10i1"><text></text></inputEntry>
        <inputEntry id="t10i2"><text></text></inputEntry>
        <inputEntry id="t10i3"><text></text></inputEntry>
        <inputEntry id="t10i4"><text></text></inputEntry>
        <inputEntry id="t10i5"><text></text></inputEntry>
        <inputEntry id="t10i6"><text></text></inputEntry>
        <inputEntry id="t10i7"><text></text></inputEntry>
        <outputEntry id="t10o1"><text>"T3"</text></outputEntry>
        <outputEntry id="t10o2"><text>"AGENT_UNMATCHED"</text></outputEntry>
        <outputEntry id="t10o3"><text>"TICKET"</text></outputEntry>
        <outputEntry id="t10o4"><text>0</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
