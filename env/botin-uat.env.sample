# ============================================================================
# COPY THIS FILE to env/botin-uat.env AND FILL IT IN.
#
#   cp env/botin-uat.env.sample env/botin-uat.env
#   # edit env/botin-uat.env
#   set -a && . ./env/botin-uat.env && set +a && mvn spring-boot:run
#
# env/botin-uat.env is excluded by .gitignore and must never be committed,
# pasted into a chat, or included in a document. THIS FILE stays empty of
# values and is the only one of the pair that is committed.
# ============================================================================

# --- Our own database. Postgres. BOTIn owns it and writes to it. ---
BOTIN_DB_URL=jdbc:postgresql://localhost:5432/botin
BOTIN_DB_USER=
BOTIN_DB_PASSWORD=

# --- UAT. MySQL. READ ONLY. BOTIn never writes here. ---
# Connect to ysmdm_admin and qualify the other two catalogs in the SQL:
#   ysmdm_users.tbl_order, ysmdm_employees.tbl_payu_transaction_details_for_sp
# readOnlyPropagatesToServer makes the server enforce it, not just the driver.
UAT_DB_URL=jdbc:mysql://<host>:3306/ysmdm_admin?readOnlyPropagatesToServer=true
UAT_DB_USER=
UAT_DB_PASSWORD=
UAT_ENABLED=true

# --- Deflection targets. Not secret; here so they travel with the rest. ---
DEEPLINK_FORGET_MPIN=yesmadam://account/security/reset-mpin
